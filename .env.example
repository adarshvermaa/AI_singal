# ==========================================
# Antigravity AI Crypto Terminal - Environment Template
# Duplicate this file as .env.local and update values as needed.
# ==========================================

# --- Backend API & WebSockets ---
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/ws
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- CoinDCX Direct Webhook Integration ---
NEXT_PUBLIC_COINDCX_WEBHOOK_URL=https://api.coindcx.com/callbacks/v1/derivatives/futures/order/YOUR_COINDCX_TOKEN
NEXT_PUBLIC_COINDCX_WEBHOOK_ID=YOUR_COINDCX_WEBHOOK_ID

# --- Antigravity AI Sentinel Inbound Secret ---
NEXT_PUBLIC_WEBHOOK_SECRET=coindcx_secret_key_8899

# --- Terminal Defaults ---
NEXT_PUBLIC_DEFAULT_PAIR=B-BTC_USDT
NEXT_PUBLIC_DEFAULT_TIMEFRAME=15m
NEXT_PUBLIC_DEFAULT_LEVERAGE=3
